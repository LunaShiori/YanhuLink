<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    设计令牌与共享样式
    ============================================================================
    设计语言：清朗（Clear & Bright）
       · 大留白、弱边框、轻阴影，信息层级靠字号与间距拉开，而不是靠重色块
       · 语义色只用于「状态」，不用于装饰
       · 全局圆角：小控件 6 / 卡片 12 / 强调块 16
       · 间距刻度：4 · 8 · 12 · 16 · 20 · 24 · 32
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         1. 品牌色
         ====================================================================== -->
    <Color x:Key="BrandPrimaryColor">#2563EB</Color>
    <Color x:Key="BrandDeepColor">#1D4ED8</Color>
    <Color x:Key="BrandSoftColor">#EFF4FF</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandDeepBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#EFF4FF" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0.0" />
        <GradientStop Color="#2563EB" Offset="0.55" />
        <GradientStop Color="#1E40AF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ======================================================================
         2. 语义状态色（仅用于表达状态，不用于装饰）
         ====================================================================== -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#12B76A" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#F79009" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F04438" />
    <SolidColorBrush x:Key="StatusUnknownBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="StatusBusyBrush" Color="#2563EB" />

    <!-- 网络热备状态色 -->
    <SolidColorBrush x:Key="FailoverGoodBrush" Color="#12B76A" />
    <SolidColorBrush x:Key="FailoverWarnBrush" Color="#F79009" />
    <SolidColorBrush x:Key="FailoverBadBrush" Color="#F04438" />
    <SolidColorBrush x:Key="FailoverErrorBrush" Color="#F04438" />
    <SolidColorBrush x:Key="FailoverBusyBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FailoverDisabledBrush" Color="#98A2B3" />

    <!-- 状态徽章的底色（带 alpha）。刻意与文字色分开：
         若直接用 Border.Opacity 调淡，文字也会一起变淡、难以辨认。 -->
    <SolidColorBrush x:Key="FailoverGoodSoftBrush" Color="#2A12B76A" />
    <SolidColorBrush x:Key="FailoverWarnSoftBrush" Color="#2AF79009" />
    <SolidColorBrush x:Key="FailoverBadSoftBrush" Color="#2AF04438" />
    <SolidColorBrush x:Key="FailoverErrorSoftBrush" Color="#2AF04438" />
    <SolidColorBrush x:Key="FailoverBusySoftBrush" Color="#2A2563EB" />
    <SolidColorBrush x:Key="FailoverDisabledSoftBrush" Color="#2A98A2B3" />

    <!-- ======================================================================
         3. 排版
         ====================================================================== -->
    <Style x:Key="DisplayStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- 小节标题（卡片内） -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 页面大标题 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ======================================================================
         4. 卡片
         ====================================================================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- 更紧凑的卡片 -->
    <Style x:Key="TightCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- 内嵌次级块（卡片内部用） -->
    <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- 列表行 -->
    <Style x:Key="BackupRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ======================================================================
         5. 按钮
         ====================================================================== -->
    <Style x:Key="MiniIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- 透明图标按钮（标题栏用） -->
    <Style x:Key="GhostIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- 大号主操作按钮（不继承 AccentButtonStyle：跨字典 BasedOn 在
         WinUI 3 的 XAML 编译期不稳定，这里显式设置关键属性） -->
    <Style x:Key="HeroButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ======================================================================
         6. 运营商选择卡（RadioButton 重绘）
         ====================================================================== -->
    <Style x:Key="IspCardStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="CheckedOverlay"
                                Background="{ThemeResource BrandPrimaryBrush}"
                                Opacity="0.10"
                                CornerRadius="10"
                                Visibility="Collapsed" />
                        <!-- 选中：右上角对勾 -->
                        <Border x:Name="CheckedMark"
                                Width="20" Height="20" CornerRadius="10"
                                Margin="0,8,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{ThemeResource BrandPrimaryBrush}"
                                Visibility="Collapsed">
                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White" />
                        </Border>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.86" Duration="0:0:0.1" />
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.68" Duration="0:0:0.08" />
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.4" Duration="0" />
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedOverlay"
                                                                   Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                    </ObjectAnimationUsingKeyFrames>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckedMark"
                                                                   Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="Indeterminate" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================
         7. 其他
         ====================================================================== -->
    <Style x:Key="StepDotStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource BrandPrimaryBrush}" />
    </Style>

</ResourceDictionary>
