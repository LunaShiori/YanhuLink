<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CampusNetLogin.Views.BrandLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        砚湖连 品牌标记（矢量版）

        与 Assets/app.ico 是同一套图形语言：
          圆角方形底（砚） + 底部水波（湖） + 中央水滴（连）。

        做成独立控件是为了「一处定义、处处一致」——
        早期版本把标题栏、向导、关于页的 Logo 各写一遍 FontIcon 字形，
        改图标时漏掉了标题栏，出现了两套视觉。现在改这里就够了。

        尺寸通过 Width/Height 由调用方指定，内部全部用比例定位，
        因此 22px 的标题栏和 64px 的向导页都清晰。
    -->

    <Grid x:Name="Root">
        <!-- 圆角底 + 品牌渐变 -->
        <Border x:Name="Backdrop"
                CornerRadius="{x:Bind CornerRadiusValue, Mode=OneWay}"
                Background="{ThemeResource BrandGradientBrush}" />

        <!-- 水波 + 水滴：用 Viewbox 承载矢量路径，随尺寸等比缩放 -->
        <Viewbox Stretch="Uniform" Margin="0,0,0,0">
            <Canvas Width="100" Height="100">

                <!-- 三层水波（自下而上由浅到深，形成湖面层次） -->
                <Path Fill="#26FFFFFF"
                      Data="M0,74 C14,68 26,80 40,74 C54,68 66,80 80,74 C90,70 96,74 100,72 L100,100 L0,100 Z" />
                <Path Fill="#42FFFFFF"
                      Data="M0,80 C14,74 26,86 40,80 C54,74 66,86 80,80 C90,76 96,80 100,78 L100,100 L0,100 Z" />
                <Path Fill="#66FFFFFF"
                      Data="M0,86 C14,80 26,92 40,86 C54,80 66,92 80,86 C90,82 96,86 100,84 L100,100 L0,100 Z" />

                <!--
                    水滴：一个圆 + 一个尖角三角。
                    路径按 100x100 画布设计，圆心 (50,52)，半径 14。
                -->
                <Path Fill="#F6FFFFFF"
                      Data="M50,25
                            C50,25 36,40 36,52
                            A14,14 0 1 0 64,52
                            C64,40 50,25 50,25 Z" />

                <!-- 高光孔：让水滴有体积感，纯白块会显得呆板 -->
                <Ellipse Fill="#C82563EB" Width="8" Height="8"
                         Canvas.Left="46" Canvas.Top="48" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
