<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNetLogin.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CampusNetLogin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 见 DashboardPage 的说明：水平滚动必须显式关闭，否则内容按无限宽测量而溢出 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24,28,32" Spacing="16" MaxWidth="820"
                    HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="版本信息、开源许可与项目地址。" />
            </StackPanel>

            <!-- 应用信息 -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:BrandLogo Grid.Column="0" Width="60" Height="60"
                                     CornerRadiusValue="16" VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" FontSize="17" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border CornerRadius="10" Padding="8,2"
                                    Background="{ThemeResource BrandPrimaryBrush}" Opacity="0.14">
                                <TextBlock x:Name="VersionBadge"
                                           Style="{StaticResource BadgeTextStyle}"
                                           Foreground="{ThemeResource BrandPrimaryBrush}" />
                            </Border>
                            <TextBlock x:Name="BuildText" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="扬州职业技术大学高邮湖校区 · 校园网自动连接工具" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="CheckUpdateButton"
                            Click="OnCheckUpdate" VerticalAlignment="Center"
                            Style="{StaticResource HeroButtonStyle}"
                            HorizontalAlignment="Right" MinWidth="128">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="13" />
                            <TextBlock Text="检查更新" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 更新结果 -->
            <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" />

            <!-- 功能说明 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="它能做什么" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A7;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}"
                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="自动认证" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="支持校园网、中国移动、中国电信、中国联通四类账号，兼容 Dr.COM 哆点 eportal 认证系统。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}"
                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="数据不出本机" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="账号、密码、配置全部保存在本机。密码使用 Windows DPAPI 按当前用户加密，换台电脑或换个账户都解不开。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}"
                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="网络热备" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="实时探测校园网延迟与丢包，异常时自动切换到你配置的热点或无线网，恢复后自动切回。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="15"
                                      Foreground="{ThemeResource BrandPrimaryBrush}"
                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="原生性能" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="基于 C# 与 Windows App SDK（WinUI 3）构建，自包含发布，无需安装 .NET 或任何运行库。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 技术信息 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="技术与许可" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="界面框架"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Windows App SDK · WinUI 3"
                                   FontSize="12.5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="运行时"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 8（自包含）"
                                   FontSize="12.5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="认证协议"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Dr.COM 哆点 eportal 4.X"
                                   FontSize="12.5" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="开源许可"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License"
                                   FontSize="12.5" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="配置位置"
                                   Style="{StaticResource CaptionStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ConfigPathText"
                                   FontSize="12" TextWrapping="Wrap"
                                   FontFamily="Consolas, Cascadia Mono, monospace" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="打开配置目录" Click="OnOpenConfigDir" Padding="12,5" />
                        <Button Content="访问项目主页" Click="OnOpenRepo" Padding="12,5" />
                        <Button Content="查看开源许可" Click="OnShowLicense" Padding="12,5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionStyle}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       Text="本项目仅供本校师生在校内网络环境使用。请遵守学校网络管理规定。" />
        </StackPanel>
    </ScrollViewer>
</Page>
