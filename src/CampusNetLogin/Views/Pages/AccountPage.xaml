<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNetLogin.Views.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 见 DashboardPage 的说明：水平滚动必须显式关闭，否则内容按无限宽测量而溢出 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24,28,32" Spacing="16" MaxWidth="820"
                    HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="账号" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="选择运营商并填写上网账号。这些信息只保存在本机，不会上传到任何服务器。" />
            </StackPanel>

            <!-- ============ 运营商 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="运营商 / 网络类型" Style="{StaticResource SectionHeaderStyle}" />

                    <ItemsControl x:Name="IspList" ItemsSource="{Binding Isps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource IspCardStyle}"
                                             MinWidth="132" MinHeight="78"
                                             GroupName="IspGroup"
                                             Tag="{Binding Name}"
                                             Checked="OnIspChecked">
                                    <StackPanel Padding="14,12" Spacing="5">
                                        <FontIcon Glyph="{Binding Symbol}" FontSize="18"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,12,0,0"
                               Text="教师和校内资源账号选「校园网」；办理了运营商宽带的学生选对应运营商。" />

                    <Border Style="{StaticResource InsetPanelStyle}" Margin="0,16,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="账号后缀" VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" x:Name="SuffixBox"
                                     PlaceholderText="留空表示不加后缀"
                                     Text="{Binding Suffix, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="保存后缀" Click="OnSaveSuffix" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="4,8,0,0"
                               Text="后缀用于区分运营商。电信 @telecom、移动 @cmcc、联通 @unicom，校园网留空。一般保持默认即可。" />
                </StackPanel>
            </Border>

            <!-- ============ 账号密码 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="账号与密码" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="7">
                        <TextBlock Text="账号" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="UsernameBox"
                                 PlaceholderText="学号 / 工号 / 手机号"
                                 Text="{Binding Username, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox Grid.Column="0" x:Name="PasswordInput"
                                         PlaceholderText="上网密码"
                                         PasswordChanged="OnPasswordChanged" />
                            <TextBox Grid.Column="0" x:Name="PlainPasswordBox"
                                     Visibility="Collapsed"
                                     PlaceholderText="上网密码"
                                     TextChanged="OnPlainPasswordChanged" />

                            <ToggleButton Grid.Column="1" x:Name="ShowPasswordToggle"
                                          Click="OnToggleShowPassword"
                                          ToolTipService.ToolTip="显示 / 隐藏密码"
                                          MinWidth="46" Height="32">
                                <FontIcon x:Name="EyeIcon" Glyph="&#xE7B3;" FontSize="14" />
                            </ToggleButton>
                        </Grid>
                    </StackPanel>

                    <ToggleSwitch MinWidth="0" Header="在本机记住密码"
                                  IsOn="{Binding SavePassword, Mode=TwoWay}"
                                  OnContent="已加密保存" OffContent="不保存" />

                    <Border Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="14"
                                      Foreground="{ThemeResource BrandPrimaryBrush}"
                                      VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="密码使用 Windows 数据保护接口（DPAPI）加密，只有当前 Windows 账户能解密。文件被复制到别的电脑也无法还原。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 操作 ============ -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="OnSave" Style="{StaticResource HeroButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Click="OnLogin" Style="{StaticResource HeroButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        <TextBlock Text="立即登录" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Click="OnLogout" Style="{StaticResource HeroButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                        <TextBlock Text="注销下线" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 登录失败排查 -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="登录失败怎么办？">
                <StackPanel Spacing="10" Padding="0,10,0,0">
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="按以下顺序排查，绝大多数问题都能解决：" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                       Text="确认已连接校园 WiFi（YZZD）或插好网线。不在校园网环境时认证服务器不可达。" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                       Text="核对运营商选择与账号后缀是否匹配。提示「账号或密码错误」时，八成是后缀不对。" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                       Text="确认账号未被其他设备占用。同一账号在多台设备同时在线时，通常会互相踢下线。" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="4" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                       Text="若提示欠费或暂停服务，请先到学校网络中心或运营商处处理。" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
