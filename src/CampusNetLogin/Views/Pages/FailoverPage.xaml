<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNetLogin.Views.Pages.FailoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 见 DashboardPage 的说明：水平滚动必须显式关闭，否则内容按无限宽测量而溢出 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24,28,32" Spacing="16" MaxWidth="900"
                    HorizontalAlignment="Left">

            <!-- ============ 页头 ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="网络热备" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,0"
                               Text="给校园网上一道保险。校园网一旦变慢或断流，自动顶到你的手机热点上，恢复后再自动切回。" />
                </StackPanel>

                <Border Grid.Column="1" x:Name="FailoverBadge"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="12" Padding="12,5" Opacity="0.16"
                        Background="{StaticResource FailoverDisabledBrush}">
                    <TextBlock x:Name="FailoverBadgeText" Style="{StaticResource BadgeTextStyle}"
                               Text="未启用"
                               Foreground="{StaticResource FailoverDisabledBrush}" />
                </Border>
            </Grid>

            <!-- ============ 总开关 ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="FailoverSwitch" MinWidth="0"
                                  Header="启用网络热备"
                                  IsOn="{Binding FailoverEnabled, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="OnFailoverToggled" />
                    <TextBlock Text="{Binding FailoverToggleDescription}"
                               Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 未启用时的说明 ============ -->
            <Border x:Name="IntroCard" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="它是怎么工作的" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                    Background="{ThemeResource BrandPrimaryBrush}" Opacity="0.14"
                                    VerticalAlignment="Top">
                                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BrandPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="持续探测" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="同时探测两个目标：校内认证服务器（判断认证是否生效）与公网地址（判断出口是否真的通）。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                    Background="{ThemeResource BrandPrimaryBrush}" Opacity="0.14"
                                    VerticalAlignment="Top">
                                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BrandPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="异常切换" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="连续多次超过阈值后，连接备用无线网，并把它的路由优先级提到校园网之前。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                    Background="{ThemeResource BrandPrimaryBrush}" Opacity="0.14"
                                    VerticalAlignment="Top">
                                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BrandPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="自动切回" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="校园网连续多次恢复正常后，把优先级还回去。全程无需手动干预。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                      Foreground="{ThemeResource StatusOfflineBrush}"
                                      VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="切换网络出口需要管理员权限。若程序当前不是管理员，备用网仍会连上，但可能无法真正接管上网流量。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 运行面板 ============ -->
            <StackPanel x:Name="RunPanel" Spacing="16"
                        Visibility="{Binding FailoverEnabled, Converter={StaticResource BoolToVisibility}}">

                <!-- 主用网络是无线时的模式说明：备用热点与校园网共用同一块网卡 -->
                <InfoBar x:Name="SharedAdapterBar" IsOpen="False" IsClosable="False"
                         Severity="Informational" Title="校园网走的是无线" />

                <!-- 实时监测 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="实时监测" Style="{StaticResource SectionHeaderStyle}" />

                        <Border Style="{StaticResource InsetPanelStyle}" Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon x:Name="CurrentNetIcon" Glyph="&#xE701;" FontSize="13"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentNetName}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentNetDetail}" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" MinWidth="72">
                                    <TextBlock Text="{Binding LastLatencyText}"
                                               Style="{StaticResource MetricValueStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="延迟" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" MinWidth="72">
                                    <TextBlock Text="{Binding LastLossText}"
                                               Style="{StaticResource MetricValueStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="丢包" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" MinWidth="86">
                                    <TextBlock Text="{Binding DownSpeedText}"
                                               Style="{StaticResource MetricValueStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="实时下行" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" MinWidth="72">
                                    <TextBlock x:Name="EgressText"
                                               Text="{Binding EgressText}"
                                               Style="{StaticResource MetricValueStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="出口" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center"
                                               ToolTipService.ToolTip="{Binding EgressDetailText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 速率条 -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon x:Name="SpeedIcon" Glyph="&#xE9D9;" FontSize="13"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="实时上行 " />
                                    <Run Text="{Binding UpSpeedText}" FontWeight="SemiBold" />
                                    <Run Text="　·　链路能力 " />
                                    <Run Text="{Binding CapacityText}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="SpeedTestButton" Click="OnSpeedTest"
                                    Padding="12,6"
                                    ToolTipService.ToolTip="下载一小段数据（不超过 512KB）估算当前带宽">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="13" />
                                    <TextBlock Text="测速" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 状态说明 + 操作 -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding FailoverHint}"
                                       VerticalAlignment="Center" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button Grid.Column="1" x:Name="ProbeNowButton" Click="OnProbeNow"
                                    Padding="12,6"
                                    ToolTipService.ToolTip="立即测量一次延迟与丢包">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                                    <TextBlock Text="检测一次" FontSize="12.5" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" x:Name="SwitchBackupButton"
                                    Click="OnSwitchToBackup" Padding="12,6"
                                    ToolTipService.ToolTip="立即改用备用网络上网">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                                    <TextBlock Text="切到备用" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 已切备用横幅 -->
                        <Border x:Name="OnBackupBanner" Visibility="Collapsed" CornerRadius="8" Padding="14,11"
                                Background="{StaticResource FailoverWarnBrush}" Opacity="0.14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                              Foreground="{StaticResource FailoverWarnBrush}" />
                                    <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                        <Run Text="当前正在使用备用网络：" />
                                        <Run Text="{Binding ActiveBackupSsid}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="切回校园网"
                                        Click="OnSwitchBackPrimary" Padding="12,5" FontSize="12" />
                            </Grid>
                        </Border>

                        <!-- 无线不可用提示 -->
                        <InfoBar x:Name="WlanBar" IsOpen="False" IsClosable="False"
                                 Severity="Warning" Title="无线网卡不可用" />
                    </StackPanel>
                </Border>

                <!-- 备用网络 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="备用网络" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="按从上到下的顺序依次尝试。勾选表示参与自动切换。" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="添加热点" Click="OnAddManualBackup" Padding="12,5" />
                                <Button Content="从已保存选择" Click="OnPickSavedWifi" Padding="12,5" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="BackupList" ItemsSource="{Binding Backups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BackupRowStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" MinWidth="0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Ssid}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Hint}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <TextBlock Text="{Binding SourceText}" FontSize="10.5"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>

                                            <Button Grid.Column="3" Style="{StaticResource MiniIconButtonStyle}"
                                                    Click="OnMoveBackupUp"
                                                    ToolTipService.ToolTip="提高优先级">
                                                <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                            </Button>

                                            <Button Grid.Column="4" Style="{StaticResource MiniIconButtonStyle}"
                                                    Click="OnMoveBackupDown"
                                                    ToolTipService.ToolTip="降低优先级">
                                                <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                            </Button>

                                            <Button Grid.Column="5" Style="{StaticResource MiniIconButtonStyle}"
                                                    Click="OnRemoveBackup"
                                                    ToolTipService.ToolTip="移除">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoBackupHint" Style="{StaticResource CaptionStyle}"
                                   Visibility="Collapsed"
                                   Margin="2,4,0,0"
                                   Text="还没有备用网络。点「添加热点」手动填手机热点的名称和密码，或点「从已保存选择」挑选系统里连过的无线网。" />

                        <Border Style="{StaticResource InsetPanelStyle}">
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="小提示：手机热点请填写「热点名称」而不是手机型号。iOS 的「个人热点」默认名称通常是 iPhone，安卓机型各不相同，可在手机设置中查看。" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 切换条件与阈值 -->
                <Border Style="{StaticResource CardStyle}" Padding="20,14">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Header="切换条件与阈值" Padding="0">
                        <StackPanel Spacing="16" Padding="0,14,0,0">

                            <StackPanel Spacing="4">
                                <TextBlock Text="判定标准" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                           Text="内网目标：延迟与丢包必须同时低于阈值，才算「校园网正常」。&#x0a;公网目标：只判断通与不通 —— 内网正常但公网不通，说明出口故障或被限速，同样视为异常并触发切换。" />
                            </StackPanel>

                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="探测间隔"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="0" Grid.Column="1" x:Name="ProbeIntervalBox"
                                           Minimum="5" Maximum="600" SmallChange="5"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding ProbeInterval, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="延迟上限（毫秒）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="LatencyBox"
                                           Minimum="20" Maximum="5000" SmallChange="50"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding LatencyThreshold, Mode=TwoWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="丢包上限（%）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="LossBox"
                                           Minimum="0" Maximum="100" SmallChange="5"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding LossThresholdPercent, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel>
                                <ToggleSwitch MinWidth="0"
                                              Header="同时探测公网出口"
                                              IsOn="{Binding ProbeTargetPublicEnabled, Mode=TwoWay}"
                                              OnContent="已开启" OffContent="已关闭" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                                           TextWrapping="Wrap"
                                           Text="开启后额外 ping 一个公网地址：能发现「认证正常、却打不开网页」的出口故障；切到热点后也能据此判断外网是否可用，无需再断网试探。个别校园网屏蔽 ICMP 出校时可关闭。" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ProbeTargetPublicEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="公网探测目标"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1" x:Name="PublicTargetBox"
                                             PlaceholderText="www.baidu.com"
                                             Text="{Binding ProbeTargetPublic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"
                                           Text="填域名或 IP 均可。建议选国内可达性好的地址（如 www.baidu.com、223.5.5.5）。" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="触发次数" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="多测几次再下结论，可以避免网络偶尔抖动导致的误切换。" />
                            </StackPanel>
                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="连续异常几次后切换"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="0" Grid.Column="1" x:Name="FailThresholdBox"
                                           Minimum="1" Maximum="20" SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding FailureThreshold, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="连续正常几次后切回"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="RecoverThresholdBox"
                                           Minimum="1" Maximum="20" SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding RecoveryThreshold, Mode=TwoWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="速率过低阈值（KB/s，0 = 不判定）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="SlowThresholdBox"
                                           Minimum="0" Maximum="100000" SmallChange="16"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding SpeedSlowThresholdKbps, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="速率监测" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="实时速率靠读网卡计数得来，不产生任何流量；只有首页可见时才做小样本主动测速。" />
                            </StackPanel>

                            <StackPanel>
                                <ToggleSwitch MinWidth="0"
                                              Header="开启速率实时监测"
                                              IsOn="{Binding SpeedMonitorEnabled, Mode=TwoWay}"
                                              OnContent="已开启" OffContent="已关闭" />
                                <TextBlock Text="{Binding SpeedMonitorToggleDescription}"
                                           Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0" />
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主动测速间隔（秒）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox Grid.Column="1" x:Name="ActiveIntervalBox"
                                           Minimum="30" Maximum="3600" SmallChange="30"
                                           SpinButtonPlacementMode="Compact"
                                           Value="{Binding SpeedActiveInterval, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel>
                                <ToggleSwitch MinWidth="0"
                                              Header="启动时预先连好备用网络"
                                              IsOn="{Binding PreemptBackup, Mode=TwoWay}"
                                              OnContent="已开启（切换更快）" OffContent="已关闭" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                                           Text="提前连上但压制其优先级，故障发生时可以秒级接管。" />
                            </StackPanel>

                            <ToggleSwitch MinWidth="0"
                                          Header="切换时在系统托盘弹出提示"
                                          IsOn="{Binding NotifyOnSwitch, Mode=TwoWay}"
                                          OnContent="已开启" OffContent="已关闭" />

                            <StackPanel>
                                <ToggleSwitch MinWidth="0"
                                              Header="打游戏 / 全屏时安静切换"
                                              IsOn="{Binding FailoverSilentInFullscreen, Mode=TwoWay}"
                                              OnContent="已开启（不打扰）" OffContent="已关闭" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                                           TextWrapping="Wrap"
                                           Text="检测到有全屏应用在前台时，切换网络不弹任何提示，避免夺走游戏焦点或造成卡顿。切换照常进行，日志里仍有记录。" />
                            </StackPanel>

                            <StackPanel>
                                <ToggleSwitch MinWidth="0"
                                              Header="切换时完全静默"
                                              IsOn="{Binding FailoverAlwaysSilent, Mode=TwoWay}"
                                              OnContent="已开启（任何情况都不提示）" OffContent="已关闭" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                                           TextWrapping="Wrap"
                                           Text="不论是否全屏都不打扰，只在日志里留痕。适合「知道它在工作，别烦我」的场景。" />
                            </StackPanel>

                            <!-- 静默提权：一次授权，之后不再弹 UAC -->
                            <Border Style="{StaticResource InsetPanelStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon x:Name="ElevationIcon" Glyph="&#xE72E;" FontSize="14"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="静默提权（推荐开启）" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                                       Text="自动切换网络需要管理员权限。开启后只需现在确认一次，之后后台运行全程不再出现 UAC 弹窗 —— 打游戏时也不会被打断。" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="ElevationStateText"
                                               Style="{StaticResource CaptionStyle}"
                                               FontWeight="SemiBold" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="GrantElevationButton" Click="OnGrantElevation"
                                                Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                                <TextBlock Text="开启静默提权" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RevokeElevationButton" Click="OnRevokeElevation"
                                                Padding="12,5" Visibility="Collapsed">
                                            <TextBlock Text="关闭静默提权" FontSize="12.5" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 保存 -->
                <Button Click="OnSave" Style="{StaticResource HeroButtonStyle}"
                        HorizontalAlignment="Left" MinWidth="150">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存热备设置" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
