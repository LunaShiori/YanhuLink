<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNetLogin.Views.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="运行日志" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0"
                           Text="记录登录、断线重连与网络热备的关键动作。界面保留最近 500 条，同时会按天写入日志文件。" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Top">
                <ToggleSwitch x:Name="AutoScrollSwitch" IsOn="True"
                              OnContent="自动滚动" OffContent="自动滚动"
                              MinWidth="0" />
                <Button Content="打开日志文件" Click="OnOpenLogFolder" Padding="12,6"
                        ToolTipService.ToolTip="在资源管理器里打开按天保存的日志文件（最多保留 7 天）" />
                <Button Content="复制全部" Click="OnCopy" Padding="12,6" />
                <Button Content="清空" Click="OnClear" Padding="12,6" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <!-- 空状态 -->
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7C3;" FontSize="30"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="还没有日志。执行一次登录或检测后，这里会显示过程记录。" />
                </StackPanel>

                <ListView x:Name="LogList"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8,6">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           Style="{StaticResource MonoStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Top" Margin="0,1,0,0" />

                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                        VerticalAlignment="Top" Margin="0,1,0,0"
                                        Background="{Binding LevelBrush}">
                                    <TextBlock Text="{Binding LevelText}" FontSize="10.5"
                                               Foreground="White" FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Message}"
                                           FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
