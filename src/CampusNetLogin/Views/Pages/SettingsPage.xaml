<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CampusNetLogin.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 见 DashboardPage 的说明：水平滚动必须显式关闭，否则内容按无限宽测量而溢出 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24,28,32" Spacing="16" MaxWidth="820"
                    HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="调整程序的自动化行为、外观与更新策略。改动会自动保存。" />
            </StackPanel>

            <!-- ============ 自动化 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="自动化" Style="{StaticResource SectionHeaderStyle}" />

                    <ToggleSwitch MinWidth="0"
                                  Header="启动时自动登录"
                                  IsOn="{Binding AutoLoginOnStart, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,10"
                               Text="程序打开时若发现未联网，自动登录一次。" />

                    <ToggleSwitch MinWidth="0"
                                  Header="后台守护（断线自动重连）"
                                  IsOn="{Binding WatchdogEnabled, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,10"
                               Text="按下面的间隔定期检查在线状态，掉线后自动重新登录。" />

                    <Grid ColumnSpacing="14" Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="检测间隔" FontSize="13" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="建议 60～300 秒。太频繁可能被服务器限制。" />
                        </StackPanel>
                        <NumberBox Grid.Column="1" x:Name="IntervalBox"
                                   Minimum="5" Maximum="3600" SmallChange="10"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{Binding IntervalSeconds, Mode=TwoWay}" />
                    </Grid>

                    <ToggleSwitch MinWidth="0"
                                  Header="点击关闭按钮时最小化到托盘"
                                  IsOn="{Binding CloseToTray, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                               Text="关闭后程序仍在后台运行并保持守护。若关闭此项，点 ✕ 将直接退出程序。" />
                </StackPanel>
            </Border>

            <!-- ============ 开机自启 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="开机启动" Style="{StaticResource SectionHeaderStyle}" />

                    <ToggleSwitch x:Name="AutoStartSwitch" MinWidth="0"
                                  Header="开机自动启动（后台运行）"
                                  IsOn="{Binding AutoStart, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="OnAutoStartToggled" />

                    <TextBlock x:Name="StartupModeText" Style="{StaticResource CaptionStyle}" />

                    <InfoBar x:Name="StartupTaskBar" IsOpen="False" IsClosable="True"
                             Severity="Informational"
                             Title="建议改用最高权限启动"
                             Message="当前使用注册表自启（普通权限），开机后自动切换网络不会生效。开启静默提权后可免除 UAC 弹窗。">
                        <InfoBar.ActionButton>
                            <Button Content="开启静默提权" Click="OnGrantElevation"
                                    Padding="12,5" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar x:Name="TaskActiveBar" IsOpen="False" IsClosable="False"
                             Severity="Success"
                             Title="已使用计划任务启动"
                             Message="开机后将以最高权限静默运行，不会弹出 UAC 提示。">
                        <InfoBar.ActionButton>
                            <Button Content="改回注册表方式" Click="OnRemoveStartupTask"
                                    Padding="12,5" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- ============ 权限（静默提权） ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="权限" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                               Text="自动切换网络需要管理员权限。开启静默提权后只需授权一次，之后后台运行全程不再出现 UAC 弹窗 —— 打游戏时也不会被打断。" />

                    <TextBlock x:Name="ElevationStatusText" Style="{StaticResource CaptionStyle}"
                               FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="GrantElevationButton" Click="OnGrantElevation" Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                <TextBlock Text="开启静默提权" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RevokeElevationButton" Click="OnRevokeElevation"
                                Padding="12,5" Visibility="Collapsed">
                            <TextBlock Text="关闭静默提权" FontSize="12.5" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 外观 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="ThemeDefault" GroupName="Theme"
                                         Content="跟随系统" Checked="OnThemeChanged" />
                            <RadioButton x:Name="ThemeLight" GroupName="Theme"
                                         Content="浅色" Checked="OnThemeChanged" />
                            <RadioButton x:Name="ThemeDark" GroupName="Theme"
                                         Content="深色" Checked="OnThemeChanged" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource InsetPanelStyle}">
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="界面使用 Win11 云母材质，在 Windows 10 上会自动回退为亚克力效果。窗口大小与主题偏好都会随系统主题切换。" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 更新 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="更新" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="尚未检查" />
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="CheckUpdateButton"
                                Content="检查更新" Click="OnCheckUpdate"
                                Padding="16,7" VerticalAlignment="Center" />
                    </Grid>

                    <ToggleSwitch MinWidth="0"
                                  Header="启动时自动检查更新"
                                  IsOn="{Binding AutoCheckUpdate, Mode=TwoWay}"
                                  OnContent="已开启" OffContent="已关闭" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                               Text="每 3 天最多检查一次，只读取版本号，不会自动下载或安装。" />

                    <Button x:Name="OpenReleaseButton" Content="打开发布页"
                            Click="OnOpenReleasePage" Padding="12,5"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ============ 维护 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="维护" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重新运行设置向导" Click="OnRerunOnboarding"
                                Padding="12,6" />
                        <Button Content="打开配置目录" Click="OnOpenConfigDir"
                                Padding="12,6" />
                    </StackPanel>

                    <Border Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="恢复出厂设置" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource StatusErrorBrush}" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="清除账号、密码、热备配置与全部偏好设置，并重新显示首次向导。此操作不可撤销。" />
                            <Button Content="清除所有设置" Click="OnResetAll"
                                    Padding="12,6" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ConfigPathText" Style="{StaticResource CaptionStyle}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
