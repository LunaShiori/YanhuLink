<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CampusNetLogin.Views.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CampusNetLogin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    PrimaryButtonText="下一步"
    SecondaryButtonText=""
    CloseButtonText="稍后设置"
    DefaultButton="Primary">

    <Grid Width="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 步骤指示 ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                    Margin="0,0,0,20" HorizontalAlignment="Center">
            <Border x:Name="Dot1" Width="24" Height="4" CornerRadius="2" />
            <Border x:Name="Dot2" Width="24" Height="4" CornerRadius="2" />
            <Border x:Name="Dot3" Width="24" Height="4" CornerRadius="2" />
            <Border x:Name="Dot4" Width="24" Height="4" CornerRadius="2" />
        </StackPanel>

        <!-- ================= 步骤内容 ================= -->
        <Grid Grid.Row="1">

            <!-- ========== 第 1 步：欢迎 ========== -->
            <StackPanel x:Name="StepWelcome" Spacing="16">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <views:BrandLogo Width="64" Height="64" CornerRadiusValue="18"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="欢迎使用砚湖连"
                               Style="{StaticResource TitleStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource CaptionStyle}" MaxWidth="380"
                               Text="砚湖连 · YanhuLink —— 为扬州职业技术大学高邮湖校区定制的校园网连接小工具。完全本地运行，不依赖任何外部环境。" />
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8A7;" FontSize="16"
                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="自动登录" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="开机后自动连接校园网，断线自动重连，通常你还没打开浏览器就已经联网了。" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16"
                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="网络热备" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="持续监测校园网质量，一旦异常自动切到手机热点，恢复正常后再自动切回。" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="隐私安全" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Text="账号密码只保存在你自己电脑上，密码经 Windows 系统级加密，不会有任何数据上传。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- ========== 第 2 步：账号 ========== -->
            <StackPanel x:Name="StepAccount" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="填写你的上网账号" Style="{StaticResource SubtitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="先选运营商，再填账号密码。这些信息之后可以在「账号」页随时修改。" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="运营商 / 网络类型" Style="{StaticResource FieldLabelStyle}" />
                    <ItemsControl x:Name="IspList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource IspCardStyle}"
                                             MinWidth="102" MinHeight="62"
                                             GroupName="OnboardingIsp"
                                             Tag="{Binding Name}"
                                             Checked="OnIspChecked">
                                    <StackPanel Padding="10,9" Spacing="4">
                                        <FontIcon Glyph="{Binding Symbol}" FontSize="16"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="账号" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="UsernameBox" PlaceholderText="学号 / 工号 / 手机号" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                    <!-- 注意：x:Name 不能与控件类型同名（PasswordBox），否则 code-behind 解析歧义 -->
                    <PasswordBox x:Name="PwdBox" PlaceholderText="上网密码" />
                </StackPanel>

                <Border Style="{StaticResource InsetPanelStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Foreground="{ThemeResource StatusOfflineBrush}"
                                  VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="登录失败多半是运营商后缀不对。若提示账号密码错误，请到「账号」页核对后缀（电信 @telecom、移动 @cmcc、联通 @unicom、校园网留空）。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========== 第 3 步：自动化 ========== -->
            <StackPanel x:Name="StepAutomation" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="让它自己工作" Style="{StaticResource SubtitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="下面几项决定了程序「有多自动」。不确定就保持默认，之后可以随时改。" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <StackPanel>
                        <ToggleSwitch x:Name="AutoLoginSwitch" MinWidth="0"
                                      Header="启动时自动登录"
                                      OnContent="已开启" OffContent="已关闭" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-4,0,8"
                                   Text="程序打开时如果发现没联网，就自动登录一次。" />

                        <ToggleSwitch x:Name="WatchdogSwitch" MinWidth="0"
                                      Header="后台守护"
                                      OnContent="已开启" OffContent="已关闭" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-4,0,8"
                                   Text="定期检查在线状态，掉线了自动重连。" />

                        <ToggleSwitch x:Name="AutoStartSwitch" MinWidth="0"
                                      Header="开机自动启动"
                                      OnContent="已开启" OffContent="已关闭" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-4,0,0"
                                   Text="开机后在后台静默运行，不弹窗口。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InsetPanelStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                  Foreground="{ThemeResource StatusOfflineBrush}"
                                  VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="网络热备需要管理员权限才能自动切换网络。它属于进阶功能，可以在「设置 → 网络热备」里单独开启，本向导不强制。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========== 第 4 步：完成 ========== -->
            <StackPanel x:Name="StepDone" Spacing="16" Visibility="Collapsed">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="{ThemeResource StatusOnlineBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="White" />
                    </Border>
                    <TextBlock Text="准备好了" Style="{StaticResource TitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="360" x:Name="SummaryText" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="接下来可以做什么" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="· 在「首页」点「立即登录」马上联网&#x0a;· 在「网络热备」配置手机热点作为应急备用&#x0a;· 在「设置」里调整自动化行为、主题与更新选项" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Grid>
</ContentDialog>
