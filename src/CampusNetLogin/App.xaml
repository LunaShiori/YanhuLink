<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CampusNetLogin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CampusNetLogin.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
