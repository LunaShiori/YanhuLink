<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    ============================================================
      砚湖连 YanhuLink —— Android 权限说明
    ============================================================

    只申请「自动登录校园网」这件事**真正需要**的权限，
    不多要一个。逐条说明如下：

    · INTERNET                      发起 HTTP 认证请求（必需）
    · ACCESS_NETWORK_STATE          判断当前是否已联网 / 监听网络变化（必需）
    · ACCESS_WIFI_STATE             读取当前连接的 WiFi 名称 SSID（必需）
    · CHANGE_WIFI_STATE             预留：部分机型需要它才能拿到 SSID
    · ACCESS_FINE_LOCATION          读取 SSID 的必要条件。
                                    Android 10+ 起，SSID 被视为位置信息，
                                    没有这个权限返回的 SSID 是 <unknown ssid>。
                                    仅用于判断「是否连的是校园网」，不采集位置。
    · POST_NOTIFICATIONS            Android 13+ 通知权限（前台服务需要常驻通知）
    · FOREGROUND_SERVICE            前台服务基础权限
    · FOREGROUND_SERVICE_DATA_SYNC  Android 14+ 前台服务必须声明具体类型
    · RECEIVE_BOOT_COMPLETED        开机自启（可选，用户可在设置里关闭）

    注意：本应用**不申请**：
      · 存储权限（配置文件放在应用私有目录）
      · 通讯录 / 相机 / 麦克风 / 后台定位
      · QUERY_ALL_PACKAGES
    也没有任何统计 SDK、广告 SDK、崩溃上报 SDK。
  -->

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- 不强制要求触摸屏；也不是游戏类应用 -->
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <!--
    目标 SDK 33（Android 13）。
    与 compileSdk 保守取同一个大版本，避免 Android 14/15 上
    前台服务类型校验带来的额外复杂度。
  -->
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:usesCleartextTraffic="true"
      android:theme="@style/AppTheme">

    <!--
      ★ 关键：校园网认证服务器是 http://172.18.1.6（明文 HTTP，非 HTTPS），
        Android 9+ 默认禁止明文流量，必须显式放行。
        这里再用 networkSecurityConfig 把范围**限制到内网地址**，
        比全局 usesCleartextTraffic 更保守。
    -->
    <meta-data
        android:name="android.security.net.config"
        android:resource="@xml/network_security_config" />

    <!--
      ★ 注意：这里**刻意不写** <activity> 声明。

      .NET for Android 会自动为每个带 [Activity] 特性的类型生成一条
      <activity>（含 MainLauncher=true 生成的 MAIN/LAUNCHER intent-filter）。
      如果这里再手写一份，构建时的 manifest 合并会产生**两条启动入口**，
      结果就是装完后桌面上出现**两个应用图标**。

      因此启动 Activity 的全部配置都集中在
      MainActivity.cs 的 [Activity] 特性里，这里保持唯一来源。
      （Service / Receiver 不存在这个问题，仍保留在清单里。）
    -->

    <!--
      WiFi 自动认证前台服务。
      前台服务会在通知栏显示常驻通知 —— 这是 Android 的硬性要求，
      不是「偷偷运行」。用户下拉通知栏可以看到并随时停止。
    -->
    <service
        android:name=".WifiLoginService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

    <!-- 开机自启（用户可在设置页关闭） -->
    <receiver
        android:name=".BootReceiver"
        android:exported="false"
        android:enabled="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

  </application>

</manifest>
